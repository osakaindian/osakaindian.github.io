# Copy this file to `.env` and fill in your own Supabase project's values.
# Find both under Project Settings > API in the Supabase dashboard.
# See SUPABASE-SETUP.md for the full walkthrough.
#
# `.env` is gitignored on purpose — never commit it. For the live site,
# the same two values are added as GitHub repository secrets instead
# (SUPABASE-SETUP.md covers that too).

PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
