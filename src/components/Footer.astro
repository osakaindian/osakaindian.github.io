---
import { site, nav } from '../site.config';

const socials = Object.entries(site.social).filter(([, url]) => url);
const labels: Record<string, string> = {
  instagram: 'Instagram',
  facebook: 'Facebook',
  whatsapp: 'WhatsApp group',
  line: 'LINE',
};
const year = new Date().getFullYear();
---

<footer>
  <div class="wrap inner">
    <div>
      <p class="name">{site.name}</p>
      <p class="ja ja-name">{site.nameJa}</p>
      <p class="addr">Osaka, Japan</p>
    </div>

    <div>
      <h2 class="h">Pages</h2>
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class="h">Reach us</h2>
      <ul>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        {
          socials.map(([key, url]) => (
            <li>
              <a href={url}>{labels[key] ?? key}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="wrap base">
    <p>© {year} {site.name}. Run by volunteers.</p>
  </div>
</footer>

<style>
  footer {
    background: var(--ink);
    color: var(--paper);
    padding-block: var(--step) 2rem;
    margin-top: var(--step);
  }

  .inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 2.5rem;
  }

  .name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    margin-bottom: 0.15em;
  }

  .ja-name {
    color: var(--marigold);
    margin-bottom: 0.6em;
  }

  .addr {
    color: var(--indigo-soft);
    margin: 0;
  }

  .h {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--indigo-soft);
    letter-spacing: 0.02em;
    margin-bottom: 0.9em;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }

  footer a {
    color: var(--paper);
    text-decoration-color: rgba(244, 245, 242, 0.35);
  }

  footer a:hover {
    color: var(--marigold);
  }

  .base {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(244, 245, 242, 0.18);
  }

  .base p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--indigo-soft);
  }
</style>
