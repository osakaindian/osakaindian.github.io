---
import { site, nav } from '../site.config';
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---

<header>
  <div class="wrap bar">
    <a class="brand" href="/">
      <img class="brand-logo" src="/images/logo.png" alt="Osaka Indian Association" />

      <span class="brand-text">
        <span class="brand-name">{site.short}</span>
        <span class="brand-full">{site.name}</span>
      </span>
    </a>

    <nav aria-label="Main">
      <ul class="menu">
        {
          nav.map((item) => (
            <li class:list={['item', { 'has-sub': item.children }]}>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
              {item.children && (
                <ul class="sub">
                  {item.children.map((c) => (
                    <li>
                      <a
                        href={`${c.href}/`}
                        aria-current={isCurrent(c.href) ? 'page' : undefined}
                      >
                        {c.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  header {
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--ink);
  }

  .brand-logo {
    width: 5rem;
    height: 3rem;
    object-fit: cover;
    flex: none;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.03em;
    font-size: 1.15rem;
  }

  .brand-full {
    font-size: 0.72rem;
    color: var(--indigo-soft);
    letter-spacing: 0.01em;
  }

  /* Top-level menu only (.menu), so the dropdown list isn't laid out as a row */
  .menu {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .item {
    position: relative;
  }

  .menu a {
    font-family: var(--font-display);
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--ink);
    padding-block: 0.15rem;
    border-bottom: 2px solid transparent;
  }

  .menu a:hover {
    border-bottom-color: var(--marigold);
    color: var(--ink);
  }

  .menu a[aria-current='page'] {
    border-bottom-color: var(--indigo);
  }

  /* Small caret on items that have a dropdown */
  .has-sub > a::after {
    content: '';
    display: inline-block;
    width: 0.35em;
    height: 0.35em;
    margin-left: 0.4em;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-0.15em) rotate(45deg);
  }

  /* Dropdown */
  .sub {
    display: none;
    position: absolute;
    top: 100%;
    left: -0.75rem;
    min-width: 12rem;
    margin: 0;
    padding: 0.5rem 0 0.4rem;
    list-style: none;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 0.4rem;
    box-shadow: 0 6px 18px rgba(17, 26, 51, 0.1);
    z-index: 30;
  }

  .sub a {
    display: block;
    padding: 0.5rem 1rem;
    border-bottom: none;
    white-space: nowrap;
  }

  .sub a:hover {
    background: var(--paper-sunk);
    border-bottom: none;
  }

  .sub a[aria-current='page'] {
    border-bottom: none;
    color: var(--indigo);
    font-weight: 600;
  }

  .has-sub:hover .sub,
  .has-sub:focus-within .sub {
    display: block;
  }

  @media (max-width: 42rem) {
    /* No hover on phones: FAQ opens the topics page instead */
    .sub {
      display: none !important;
    }

    .has-sub > a::after {
      display: none;
    }
  }

  @media (max-width: 34rem) {
    .brand-full {
      display: none;
    }
    .menu a {
      font-size: 0.9rem;
    }
  }
</style>