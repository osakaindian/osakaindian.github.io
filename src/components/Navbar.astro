---
import { site, nav } from '../site.config';
import { withBase } from '../lib/base';
const path = Astro.url.pathname;
const isCurrent = (href: string) => {
  const full = withBase(href);
  return path === full || path.startsWith(full + '/');
};
---

<header>
  <div class="wrap bar">
    <a class="brand" href={withBase('/')}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-text">
        <span class="brand-name">{site.short}</span>
        <span class="brand-full">{site.name}</span>
      </span>
    </a>

    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={withBase(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  header {
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--ink);
  }

  /* A marigold bloom reduced to its simplest form: a filled disc inside a ring. */
  .brand-mark {
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    border: 2px solid var(--indigo);
    background:
      radial-gradient(circle at center, var(--marigold) 0 42%, transparent 43%);
    flex: none;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.03em;
    font-size: 1.15rem;
  }

  .brand-full {
    font-size: 0.72rem;
    color: var(--indigo-soft);
    letter-spacing: 0.01em;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    font-family: var(--font-display);
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--ink);
    padding-block: 0.15rem;
    border-bottom: 2px solid transparent;
  }

  nav a:hover {
    border-bottom-color: var(--marigold);
    color: var(--ink);
  }

  nav a[aria-current='page'] {
    border-bottom-color: var(--indigo);
  }

  @media (max-width: 34rem) {
    .brand-full {
      display: none;
    }
    nav a {
      font-size: 0.9rem;
    }
  }
</style>
