---
// Edit these numbers to match reality. Keep it to 3 or 4 items.
const stats = [
  { value: '2016', label: 'founded' },
  { value: '300+', label: 'members' },
  { value: '25', label: 'events a year' },
  { value: '12', label: 'universities and companies represented' },
];
---

<section class="stats" aria-label="The association in numbers">
  <div class="wrap">
    <dl>
      {
        stats.map((s) => (
          <div>
            <dd>{s.value}</dd>
            <dt>{s.label}</dt>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .stats {
    border-bottom: 1px solid var(--rule);
  }

  dl {
    margin: 0;
    padding: 1.75rem 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 1.25rem 2rem;
  }

  dl div {
    display: flex;
    flex-direction: column-reverse;
    padding-left: 1rem;
    border-left: 2px solid var(--marigold);
  }

  dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.1;
  }

  dt {
    color: var(--indigo);
    font-size: 0.95rem;
  }
</style>