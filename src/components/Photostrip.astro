---
// Put 4 photos in /public/photos/ and list them here.
// Use real photos of real events, with permission from the people in them.
const photos = [
  { src: '/photos/diwali.jpg', alt: 'Members lighting diyas at the Diwali gathering', caption: 'Diwali' },
  { src: '/photos/holi.jpg', alt: 'Colourful faces at the Holi celebration', caption: 'Holi' },
  { src: '/photos/picnic.jpg', alt: 'Families on Janmashtami festival event', caption: 'Janmashtami' },
  { src: '/photos/welcome.jpg', alt: 'Newcomers chatting over chai at a welcome meetup', caption: 'Welcome meetup' },
];
---

<section class="band">
  <div class="wrap">
    <h2>Who shows up</h2>
    <ul class="strip">
      {
        photos.map((p) => (
          <li>
            <figure>
              <img src={p.src} alt={p.alt} loading="lazy" width="600" height="450" />
              <figcaption>{p.caption}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
  }

  figure {
    margin: 0;
  }

  img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--rule);
  }

  figcaption {
    margin-top: 0.4rem;
    color: var(--indigo);
    font-size: 0.9rem;
  }

  @media (max-width: 52rem) {
    .strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>