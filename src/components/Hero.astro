---
import { site } from '../site.config';
import { weekdayDate, time } from '../lib/date';

interface Props {
  next?: {
    slug: string;
    title: string;
    date: Date;
    venue: string;
  };
}

const { next } = Astro.props;
---

<section class="hero">
  <div class="wrap grid">
    <div class="titling">
      <h1>Osaka<br />Indian<br />Association</h1>
      <p class="ja kanji">{site.nameJa}</p>
    </div>

    <div class="side">
      <p class="lede">{site.tagline}</p>

      {
        next ? (
          <a class="next" href={`/events/${next.slug}/`}>
            <span class="next-label">Next gathering</span>
            <span class="next-title">{next.title}</span>
            <span class="next-meta">
              {weekdayDate(next.date)}, {time(next.date)} · {next.venue}
            </span>
          </a>
        ) : (
          <div class="next next--empty">
            <span class="next-label">Next gathering</span>
            <span class="next-title">Being planned</span>
            <span class="next-meta">
              Join the mailing list and you’ll hear about it first.
            </span>
          </div>
        )
      }

      <div class="acts">
        <a class="btn" href={site.joinFormUrl || '/contact/'}>Join the community</a>
        <a class="btn btn--quiet" href="/events/">See all events</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 7vw, 5.5rem) var(--step);
    border-bottom: 1px solid var(--rule);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: end;
  }

  h1 {
    margin: 0;
    font-weight: 700;
    letter-spacing: -0.045em;
    font-size: clamp(3rem, 9.5vw, 6.2rem);
    line-height: 0.92;
  }

  .kanji {
    margin: 0.7rem 0 0;
    font-size: clamp(1rem, 1.6vw, 1.3rem);
    font-weight: 600;
    color: var(--indigo-soft);
    letter-spacing: 0.22em;
  }

  .lede {
    margin-bottom: 2rem;
  }

  .next {
    display: block;
    text-decoration: none;
    color: var(--ink);
    background: var(--paper-sunk);
    border-left: 5px solid var(--marigold);
    padding: 1.35rem 1.5rem;
    margin-bottom: 1.75rem;
  }

  .next:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .next:hover .next-label,
  .next:hover .next-meta {
    color: var(--marigold);
  }

  .next--empty:hover {
    background: var(--paper-sunk);
    color: var(--ink);
  }

  .next--empty:hover .next-label,
  .next--empty:hover .next-meta {
    color: var(--indigo);
  }

  .next-label {
    display: block;
    font-family: var(--font-display);
    font-size: 0.82rem;
    color: var(--indigo);
    margin-bottom: 0.35rem;
  }

  .next-title {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.35rem, 2.4vw, 1.8rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-bottom: 0.4rem;
  }

  .next-meta {
    display: block;
    font-size: 0.95rem;
    color: var(--indigo);
  }

  .acts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (max-width: 52rem) {
    .grid {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
