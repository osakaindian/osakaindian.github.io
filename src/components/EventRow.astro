---
import { day, month, time } from '../lib/date';

interface Props {
  slug: string;
  title: string;
  date: Date;
  endTime?: string;
  venue: string;
  summary: string;
  past?: boolean;
}

const { slug, title, date, endTime, venue, summary, past = false } = Astro.props;
---

<article class:list={['row', { past }]}>
  <div class="when" aria-hidden="true">
    <span class="d">{day(date)}</span>
    <span class="m">{month(date)}</span>
  </div>

  <div class="what">
    <h3><a href={`/events/${slug}/`}>{title}</a></h3>
    <p class="meta">
      <time datetime={date.toISOString()}>
        {time(date)}{endTime ? ` – ${endTime}` : ''}
      </time>
      <span class="sep" aria-hidden="true"></span>
      {venue}
    </p>
    <p class="summary">{summary}</p>
  </div>
</article>

<style>
  .row {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1.5rem;
    padding-block: 1.8rem;
    border-top: 1px solid var(--rule);
    align-items: start;
  }

  .when {
    font-family: var(--font-display);
    text-align: center;
    padding: 0.5rem 0.25rem;
    border: 1.5px solid var(--indigo);
    border-radius: 2px;
    line-height: 1;
  }

  .d {
    display: block;
    font-size: 1.7rem;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .m {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.78rem;
    color: var(--indigo);
  }

  .past .when {
    border-color: var(--rule);
    color: var(--indigo-soft);
  }

  .past .m {
    color: var(--indigo-soft);
  }

  h3 {
    margin-bottom: 0.3rem;
  }

  h3 a {
    text-decoration: none;
    color: var(--ink);
    background-image: linear-gradient(var(--marigold), var(--marigold));
    background-repeat: no-repeat;
    background-size: 0% 3px;
    background-position: 0 100%;
    transition: background-size 0.2s ease;
  }

  h3 a:hover,
  h3 a:focus-visible {
    background-size: 100% 3px;
    color: var(--ink);
  }

  .meta {
    margin: 0 0 0.45rem;
    font-family: var(--font-display);
    font-size: 0.9rem;
    color: var(--indigo);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .sep {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--marigold);
    flex: none;
  }

  .summary {
    margin: 0;
    color: var(--ink);
  }

  .past .summary,
  .past .meta {
    color: var(--indigo-soft);
  }

  @media (max-width: 30rem) {
    .row {
      grid-template-columns: 3.6rem 1fr;
      gap: 1rem;
    }
    .d {
      font-size: 1.4rem;
    }
  }
</style>
