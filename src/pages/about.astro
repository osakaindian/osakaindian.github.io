---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
---

<Base title="About" description="What the Osaka Indian Association is and who it is for.">
  <section class="band head">
    <div class="wrap wrap--narrow">
      <h1>About Us</h1>
      <p class="lede">
        A community for Indian students, researchers, professionals, alumni,
        and prospective students in and around Osaka.
      </p>
    </div>
  </section>

  <section class="band top">
    <div class="wrap wrap--narrow">
      <p>
        We help people connect, settle into life in Osaka, and celebrate Indian culture
        together, at every stage of their journey in Japan.
      </p>

      <h2>What we do</h2>
      <dl class="points">
        <div>
          <dt>Events</dt>
          <dd>Cultural celebrations, social gatherings, and sports activities through the year.</dd>
        </div>
        <div>
          <dt>Practical help</dt>
          <dd>Shared experience on university life, housing, local procedures, and daily life in Japan.</dd>
        </div>
        <div>
          <dt>For students</dt>
          <dd>Current students meet people across universities. Prospective students hear from those who have already made the move.</dd>
        </div>
      </dl>

      <h2>Events we share</h2>
      <p>
        Events organised by us are clearly marked as ours. We also list other events across
        Kansai that may interest the community, Indian and otherwise. These are shared for
        information only, and we are not the organisers. Please rely on the organisers' own
        pages for the latest details, and note that our list is not complete.
      </p>

      <h2>How it works</h2>
      <p>
        The association is run by a small team. There is no membership fee and no application
        to join. Some events may have costs, such as venue or catering, and we share these
        in advance.
      </p>

      <h2>Get involved</h2>
      <p>
        Want to help organise an event, share what you know with newcomers, or just meet
        people? We'd love to hear from you.
      </p>
      <p><a class="btn" href={site.joinFormUrl || '/contact/'}>Get in touch</a></p>
    </div>
  </section>
</Base>

<style>
  .head {
    padding-block: clamp(2.5rem, 6vw, 4rem) 0;
  }

  .top {
    padding-top: 2.5rem;
  }

  h2 {
    font-size: 1.6rem;
    margin-top: 2.4rem;
  }

  .points {
    margin: 0;
    display: grid;
    gap: 1.1rem;
  }

  .points div {
    padding-left: 1rem;
    border-left: 2px solid var(--marigold);
  }

  dt {
    font-family: var(--font-display);
    font-weight: 600;
  }

  dd {
    margin: 0.15rem 0 0;
    color: var(--indigo);
  }
</style>