---
import Base from '../layouts/Base.astro';
import { site, whoWeAre } from '../site.config';
import { withBase } from '../lib/base';
---

<Base title="About" description="What the Osaka Indian Association is and who it is for.">
  <section class="band head">
    <div class="wrap wrap--narrow">
      <h1>About</h1>
      <p class="lede">
        A volunteer-run community, not an official body. Nobody here works for a
        government or a university.
      </p>
    </div>
  </section>

  <section class="band top">
    <div class="wrap wrap--narrow">
      <p>
        The Osaka Indian Association brings together Indian students,
        researchers, professionals and alumni living in and around Osaka. We run
        festivals through the year, help people find their footing when they
        first arrive, and give everyone a reason to be in the same room every
        few weeks.
      </p>
      <p>
        Most of what we do is small: a lunch, a cricket afternoon, a group chat
        where someone answers your question about the ward office at eleven at
        night. Twice a year it gets bigger — Diwali and Holi fill a hall.
      </p>

      <h2>Who comes</h2>
      <dl class="groups">
        {
          whoWeAre.map((g) => (
            <div>
              <dt>{g.group}</dt>
              <dd>{g.note}</dd>
            </div>
          ))
        }
      </dl>

      <h2>How it works</h2>
      <p>
        There is no membership fee and no form to fill in before you turn up.
        A committee of volunteers organises events for a year at a time and then
        hands over to the next group. If something at an event costs money —
        usually a hall booking or catering — we say so in advance.
      </p>

      <h2>Helping out</h2>
      <p>
        The association only exists because people give it a few hours. If you
        can cook, carry chairs, take photographs, keep accounts, or read a
        Japanese rental contract without panicking, we would like to hear from
        you.
      </p>
      <p><a class="btn" href={withBase(site.joinFormUrl || '/contact/')}>Get in touch</a></p>
    </div>
  </section>
</Base>

<style>
  .head {
    padding-block: clamp(2.5rem, 6vw, 4rem) 0;
  }

  .top {
    padding-top: 2.5rem;
  }

  h2 {
    font-size: 1.6rem;
    margin-top: 2.8rem;
  }

  .groups {
    margin: 0;
    display: grid;
    gap: 1.1rem;
  }

  .groups div {
    padding-left: 1rem;
    border-left: 2px solid var(--marigold);
  }

  dt {
    font-family: var(--font-display);
    font-weight: 600;
  }

  dd {
    margin: 0.15rem 0 0;
    color: var(--indigo);
  }
</style>
