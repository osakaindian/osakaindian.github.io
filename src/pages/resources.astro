const slugify = (s: string) =>
  s.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

const tagKey = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<Base
  title="Living in Osaka"
  description="Practical notes for Indians arriving in Osaka: ward office, insurance, groceries, transport."
>
  <section class="band head">
    <div class="wrap wrap--narrow">
      <h1>Living in Osaka</h1>
      <p class="lede">
        A practical guide to living and settling in Osaka, covering essential administrative procedures, daily necessities, and other aspects of everyday life.
      </p>
    </div>
  </section>

  <section class="band top">
    <div class="wrap layout">
      <nav class="toc" aria-label="Sections on this page">
        <p class="toc-label">On this page</p>
        <ul>
          {
            sections.map((s) => (
              <li>
                <a href={`#${slugify(s.title)}`}>{s.title}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="content">
        <p class="caveat">
          This guide is based on experiences shared by members of our community and is intended as a practical starting point. Administrative procedures and eligibility 
          requirements can change, so please confirm important matters with your municipality, university, or the relevant government office before taking action.
        </p>

        {
          sections.map((s) => (
            <section class="sect" id={slugify(s.title)}>
              <h2>{s.title}</h2>

              {s.places ? (
                <>
                  {s.intro && <p class="sect-intro">{s.intro}</p>}
                  <div class="place-list">
                    {s.places.map((place) => (
                      <a class="place" href={place.url} target="_blank" rel="noopener">
                        <div class="place-main">
                          <span class="place-name">{place.name}</span>
                          <span class="place-area">{place.area}</span>
                        </div>
                        <div class="tags">
                          {place.types.map((type) => (
                            <span class="tag" data-tag={tagKey(type)}>{type}</span>
                          ))}
                        </div>
                      </a>
                    ))}
                  </div>
                </>
              ) : (
                <dl>
                  {s.items.map(([term, body]) => (
                    <div>
                      <dt>{term}</dt>
                      <dd>{body}</dd>
                    </div>
                  ))}
                </dl>
              )}
            </section>
          ))
        }

        <p class="ask">
          Something missing? <a href={`mailto:${site.email}`}>Tell us</a> and we
          will add it.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .head {
    padding-block: clamp(2.5rem, 6vw, 4rem) 0;
  }

  .top {
    padding-top: 2.5rem;
  }

  /* wrap--narrow caps line length for reading; this page needs the wider
     wrap so the side nav has somewhere to sit. */
  .layout {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .content {
    max-width: 48rem;
  }

  .toc {
    position: sticky;
    top: 1.5rem;
  }

  .toc-label {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--indigo-soft);
    margin: 0 0 0.75rem;
  }

  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.1rem;
    border-left: 2px solid var(--rule);
  }

  .toc a {
    display: block;
    padding: 0.4rem 0 0.4rem 0.9rem;
    margin-left: -2px;
    border-left: 2px solid transparent;
    font-family: var(--font-display);
    font-size: 0.92rem;
    text-decoration: none;
    color: var(--indigo);
    line-height: 1.3;
  }

  .toc a:hover {
    color: var(--ink);
    border-left-color: var(--indigo-soft);
  }

  .caveat {
    background: var(--paper-sunk);
    border-left: 4px solid var(--indigo-soft);
    padding: 1rem 1.2rem;
    font-size: 0.95rem;
    color: var(--indigo);
    max-width: none;
  }

  .sect {
    margin-top: 3rem;
    scroll-margin-top: 1.5rem;
  }

  .sect:first-of-type {
    margin-top: 2.5rem;
  }

  h2 {
    font-size: 1.6rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .sect-intro {
    margin-top: 1.25rem;
    max-width: var(--measure);
  }

  dl {
    margin: 1.5rem 0 0;
    display: grid;
    gap: 1.5rem;
  }

  dt {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    margin-bottom: 0.25rem;
  }

  dd {
    margin: 0;
    max-width: var(--measure);
  }

  /* Place directory */
  .place-list {
    margin-top: 1.5rem;
    display: grid;
    gap: 0.75rem;
  }

  .place {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--rule);
    border-radius: 0.6rem;
    text-decoration: none;
    color: inherit;
    background: var(--paper);
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .place:hover {
    border-color: var(--indigo-soft);
    background: var(--paper-sunk);
  }

  .place-main {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 10rem;
  }

  .place-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.02rem;
    color: var(--indigo);
  }

  .place-area {
    font-size: 0.85rem;
    color: var(--ink);
    opacity: 0.65;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: var(--paper-sunk);
    color: var(--indigo);
    border: 1px solid var(--rule);
    white-space: nowrap;
  }

  /* Subtle per-category tint — falls back to the default indigo tag above
     if a type doesn't match one of these keys. */
  .tag[data-tag='vegetarian'] {
    color: #3f7d4a;
    border-color: #bfe0c4;
    background: #eef8ef;
  }

  .tag[data-tag='halal'] {
    color: #8a5a10;
    border-color: #ecd6ab;
    background: #fbf3e3;
  }

  .tag[data-tag='groceries'] {
    color: var(--indigo);
    border-color: var(--rule);
    background: var(--paper-sunk);
  }

  .ask {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  /* Below this width the side nav sits above the content as a horizontal
     scroller instead of squeezing a two-column layout onto a phone. */
  @media (max-width: 42rem) {
    .layout {
      grid-template-columns: 1fr;
    }

    .toc {
      position: static;
      overflow-x: auto;
      padding-bottom: 0.5rem;
    }

    .toc ul {
      display: flex;
      gap: 0.5rem;
      border-left: none;
      white-space: nowrap;
    }

    .toc a {
      border: 1px solid var(--rule);
      border-radius: 999px;
      padding: 0.35rem 0.9rem;
      margin-left: 0;
    }

    .toc a:hover {
      border-color: var(--indigo-soft);
    }

    .place {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>