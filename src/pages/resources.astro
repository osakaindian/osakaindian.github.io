---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';

// Edit this list to change the guide. Each section renders as a block, and
// the side navigation is generated from the same titles — add a section here
// and a link appears automatically, nothing else to update.
const sections = [

  {
    title: 'Getting Started',
    items: [
      [
