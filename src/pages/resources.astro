---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';

// Edit this list to change the guide. Each section renders as a block, and
// the side navigation is generated from the same titles — add a section here
// and a link appears automatically, nothing else to update.
//
// A section can be one of three shapes:
//   - places:  a directory of links (see Food)
//   - image:   a single image instead of text (see Travel)
//   - table:   a two-column table, written either as
//        items:  [[term, description], ...]            (one simple table)
//        groups: [{ label, rows: [[term, description, optional badge]] }]
//                                                      (table with sub-headings)
//      Optional `cols: ['Left heading', 'Right heading']` renames the
//      column headings. Defaults: items → Topic / Details,
//      groups → Situation / What to do.
const sections = [
  {
    title: 'Emergency',
    groups: [
      {
        label: 'Call right away',
        rows: [
          [
            'Medical emergency or fire',
            'Ask for an ambulance. Give your location as clearly as you can and follow the operator\'s instructions.',
            '119'
          ],
          [
            'Police emergency',
            'Call when you need urgent help from the police.',
            '110'
          ]
        ]
      },
      {
        label: 'Healthcare',
        rows: [
          [
            'Feeling unwell',
            'Start with a nearby clinic. Your university may have a list of clinics familiar with international students.'
          ],
          [
            'Health insurance',
            'Bring your insurance card. What you pay depends on your coverage and treatment.'
          ],
          [
            'Large hospitals',
            'May ask for a clinic referral or charge an extra fee without one. Check requirements before going.'
          ],
          [
            'Language support',
            'Look for clinics with multilingual staff, or ask your international office for recommendations.'
          ]
        ]
      },
      {
        label: 'Lost items & paperwork',
        rows: [
          [
            'Lost wallet or belongings',
            'Report it at the nearest police station or kōban.'
          ],
          [
            'Lost residence card',
            'Contact the authorities and follow the current replacement process. Keep a photo or copy somewhere safe.'
          ],
          [
            'Immigration questions',
            'Use official Immigration Services Agency information, or ask your university\'s international student office.'
          ],
          [
            'Housing problems',
            'Keep your contract and all written messages. Your international office or a local consultation service can point you to support.'
          ]
        ]
      },
      {
        label: 'Not sure?',
        rows: [
          [
            'Ask the community',
            'Ask the association. Someone may have faced the same situation and can point you to the right office.'
          ]
        ]
      }
    ]
  },

  {
    title: 'Food',
    intro:
      'A few real, verified online stores that ship Indian, South Asian, and halal groceries across Japan — handy if you can\'t make it to a physical shop.',
    places: [
      {
        name: 'Vishwas Spices Japan',
        area: 'Amagasaki, Hyogo (ships nationwide)',
        types: ['Groceries'],
        url: 'https://vishwasjapan.com'
      },
      {
        name: 'Ambika Japan',
        area: 'Tokyo (ships nationwide)',
        types: ['Vegetarian', 'Groceries'],
        url: 'https://shop.ambikajapan.com'
      },
      {
        name: 'Shinjuku Halal Food',
        area: 'Tokyo (ships nationwide)',
        types: ['Halal', 'Groceries'],
        url: 'https://shinjukuhalalfood.com'
      }
      // Add more places here — name, area, types (array), url.
    ]
  },

  // {
  //   title: 'Food & Groceries',
  //   items: [
  //     [
  //       'Indian groceries',
  //       'Rice, atta, dals, spices, and other Indian ingredients are available at specialist shops and some larger supermarkets. Availability varies by area, so ask other community members about shops near you.'
  //     ],
  //     [
  //       'Vegetarian food',
  //       'Vegetarian options are increasingly common, but ingredients such as fish stock, meat-based broth, or animal-derived ingredients can appear in dishes that otherwise look vegetarian. When in doubt, ask about the ingredients.'
  //     ],
  //     [
  //       'Halal food',
  //       'Halal restaurants and grocery stores are available in several parts of Osaka. Muslim students can also check whether their university provides information about nearby halal options.'
  //     ],
  //     [
  //       'Supermarkets',
  //       'Local supermarkets are generally the easiest place to buy everyday groceries. Discount supermarkets can be particularly useful for students managing a limited budget.'
  //     ],
  //     [
  //       'Eating out',
  //       'Restaurants in Osaka range from inexpensive student-friendly options to specialist Indian, South Asian, vegetarian, and halal restaurants. Sharing recommendations within the community can help newcomers find places that suit their needs.'
  //     ]
  //   ]
  // },

  {
    title: 'Travel',
    // The image lives in /public/faq/Travel.jpeg and is served from the site root.
    image: {
      src: '/faq/Travel.jpeg',
      alt: 'Travel guide for Osaka covering the ICOCA card, trains and subways, bicycles, walking, and late-night travel.'
    }
  },

  // {
  //   title: 'Apps',
  //   // The image lives in /public/faq/Travel.jpeg and is served from the site root.
  //   image: {
  //     src: '/faq/apps.jpeg',
  //     alt: 'Life is easier online, hmmm...?'
  //   }
  // },
  {
    title: 'Apps',
    cols: ['Apps', 'What it\'s for?'],
    items: [
      [
        'Google Maps',
        'Google Maps works well for routes, and Japanese apps like Jorudan or NAVITIME show platform numbers and last-train times. Check the last train before heading out at night.'
      ],
      [
        'Google Translate',
        'Google Translate\'s camera mode is handy for reading menus, food labels, and letters. Download the Japanese language pack so it works offline.'
      ],
      [
        'Payments',
        'Mobile payment apps such as PayPay are widely accepted and often run discounts. Keep some cash as a backup.'
      ],
      [
        'Tabelog',
        'Tabelog is the main Japanese restaurant site, and Google Maps reviews are also useful. Filter by "vegetarian" or "halal" where available, but confirm ingredients directly.'
      ]
    ]
  },
  {
    title: 'Day trips',
    cols: ['Place', 'Why go'],
    items: [
      [
        'Kyoto',
        'Temples, old streets, and autumn colours, about 30 to 45 minutes by train. Popular spots get very crowded on weekends and in peak seasons, so go early.'
      ],
      [
        'Nara',
        'Free-roaming deer, Todai-ji, and a relaxed pace. Easy to cover in a half day.'
      ],
      [
        'Hyogo',
        'Kobe, scenic coastlines, Mount Rokko, and Arima Onsen. Easy to reach from Osaka, with Awaji Island also nearby.'
      ],
      [
        'Himeji',
        'Home to Himeji Castle, one of Japan\'s best-preserved castles. Plan a few hours for the castle and grounds.'
      ],
      [
        'Koyasan',
        'A mountain temple town with temple lodgings (shukubo). A good choice if you want something quiet and different.'
      ],
      [
        'Lake Biwa',
        'Japan’s largest lake, known for beautiful scenery, cycling, and relaxing lakeside spots. Great for a slower day trip.'
      ]
    ]
  },
  {
    title: 'Etiquettes',
    items: [
      [
        'Shoes',
        'Take your shoes off at homes and some restaurants, clinics, and ryokan. Look for a raised entrance step or shoe lockers.'
      ],
      [
        'Tipping',
        'There is no tipping. Good service is expected as standard.'
      ],
      [
        'On trains',
        'Keep your voice low, avoid phone calls, and put your bag on your lap or the rack if it\'s busy.'
      ],
      [
        'Escalators',
        'In Osaka, people usually stand on the right and walk on the left, the reverse of Tokyo.'
      ],
      [
        'Garbage',
        'Bins in public are scarce, so carry your trash with you until you find one. Sorting rules at home are strict, so check your ward\'s schedule.'
      ]
    ]
  },
];

const slugify = (s: string) =>
  s.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

const tagKey = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-');

// Table sections: `items` becomes one unlabelled group, `groups` is used as-is.
const groupsOf = (s: any) => s.groups ?? [{ rows: s.items ?? [] }];
const colsOf = (s: any) =>
  s.cols ?? (s.groups ? ['Situation', 'What to do'] : ['Topic', 'Details']);
---

<Base
  title="Living in Osaka"
  description="Practical notes for Indians arriving in Osaka: ward office, insurance, groceries, transport."
>
  <section class="band head">
    <div class="wrap wrap--narrow">
      <h1>Living in Osaka</h1>
      <p class="lede">
        A practical guide to living and settling in Osaka, covering essential administrative procedures, daily necessities, and other aspects of everyday life.
      </p>
    </div>
  </section>

  <section class="band top">
    <div class="wrap wrap--narrow">
      <nav class="toc" aria-label="Sections on this page">
        <p class="toc-label">On this page</p>
        <ul>
          {
            sections.map((s) => (
              <li>
                <a href={`#${slugify(s.title)}`}>{s.title}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="content">
        <p class="caveat">
          This guide is based on experiences shared by members of our community and is intended as a practical starting point. Administrative procedures and eligibility 
          requirements can change, so please confirm important matters with your municipality, university, or the relevant government office before taking action.
        </p>

        {
          sections.map((s) => (
            <section class="sect" id={slugify(s.title)}>
              <h2>{s.title}</h2>

              {s.places ? (
                <>
                  {s.intro && <p class="sect-intro">{s.intro}</p>}
                  <div class="place-list">
                    {s.places.map((place) => (
                      <a class="place" href={place.url} target="_blank" rel="noopener">
                        <div class="place-main">
                          <span class="place-name">{place.name}</span>
                          <span class="place-area">{place.area}</span>
                        </div>
                        <div class="tags">
                          {place.types.map((type) => (
                            <span class="tag" data-tag={tagKey(type)}>{type}</span>
                          ))}
                        </div>
                      </a>
                    ))}
                  </div>
                </>
              ) : s.image ? (
                <a class="figure-link" href={s.image.src} target="_blank" rel="noopener">
                  <img
                    class="figure"
                    src={s.image.src}
                    alt={s.image.alt}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              ) : (
                <div class="table-wrap">
                  <table class="quick">
                    <thead>
                      <tr>
                        <th scope="col">{colsOf(s)[0]}</th>
                        <th scope="col">{colsOf(s)[1]}</th>
                      </tr>
                    </thead>
                    {groupsOf(s).map((g) => (
                      <tbody>
                        {g.label && (
                          <tr class="group-row">
                            <th colspan="2" scope="colgroup">{g.label}</th>
                          </tr>
                        )}
                        {g.rows.map(([term, body, badge]) => (
                          <tr>
                            <th scope="row">
                              {term}
                              {badge && <span class="call">{badge}</span>}
                            </th>
                            <td>{body}</td>
                          </tr>
                        ))}
                      </tbody>
                    ))}
                  </table>
                </div>
              )}
            </section>
          ))
        }

        <p class="ask">
          Something missing? <a href={`mailto:${site.email}`}>Tell us</a> and we
          will add it.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .head {
    padding-block: clamp(2.5rem, 6vw, 4rem) 0;
  }

  .top {
    padding-top: 2.5rem;
  }

  /* wrap--narrow caps line length for reading; this page needs the wider
     wrap so the side nav has somewhere to sit. */
  .layout {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .content {
    max-width: 48rem;
  }

  .toc {
    position: sticky;
    top: 1.5rem;
  }

  .toc-label {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--indigo-soft);
    margin: 0 0 0.75rem;
  }

  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.1rem;
    border-left: 2px solid var(--rule);
  }

  .toc a {
    display: block;
    padding: 0.4rem 0 0.4rem 0.9rem;
    margin-left: -2px;
    border-left: 2px solid transparent;
    font-family: var(--font-display);
    font-size: 0.92rem;
    text-decoration: none;
    color: var(--indigo);
    line-height: 1.3;
  }

  .toc a:hover {
    color: var(--ink);
    border-left-color: var(--indigo-soft);
  }

  .caveat {
    background: var(--paper-sunk);
    border-left: 4px solid var(--indigo-soft);
    padding: 1rem 1.2rem;
    font-size: 0.95rem;
    color: var(--indigo);
    max-width: none;
  }

  .sect {
    margin-top: 3rem;
    scroll-margin-top: 1.5rem;
  }

  .sect:first-of-type {
    margin-top: 2.5rem;
  }

  h2 {
    font-size: 1.6rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .sect-intro {
    margin-top: 1.25rem;
    max-width: var(--measure);
  }

  /* Image section (Travel) */
  .figure-link {
    display: block;
    margin-top: 1.5rem;
  }

  .figure {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: 0.6rem;
    background: var(--paper-sunk);
  }

  /* Tables (every items / groups section) */
  .table-wrap {
    margin-top: 1.5rem;
    border: 1px solid var(--rule);
    border-radius: 0.6rem;
    overflow: hidden;
  }

  .quick {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .quick thead th {
    text-align: left;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--indigo-soft);
    padding: 0.7rem 1rem;
    background: var(--paper-sunk);
    border-bottom: 1px solid var(--rule);
  }

  .quick .group-row th {
    text-align: left;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--indigo);
    padding: 0.55rem 1rem;
    background: var(--paper-sunk);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .quick tbody:first-of-type .group-row th {
    border-top: none;
  }

  .quick tbody tr:not(.group-row) th,
  .quick tbody tr:not(.group-row) td {
    padding: 0.75rem 1rem;
    vertical-align: top;
    border-bottom: 1px solid var(--rule);
  }

  .quick tbody tr:last-child th,
  .quick tbody tr:last-child td {
    border-bottom: none;
  }

  .quick tbody tr:not(.group-row) th {
    width: 11rem;
    text-align: left;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink);
  }

  .call {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #9b2c2c;
    background: #fdeeee;
    border: 1px solid #f1c4c4;
    vertical-align: baseline;
  }

  /* Place directory */
  .place-list {
    margin-top: 1.5rem;
    display: grid;
    gap: 0.75rem;
  }

  .place {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--rule);
    border-radius: 0.6rem;
    text-decoration: none;
    color: inherit;
    background: var(--paper);
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .place:hover {
    border-color: var(--indigo-soft);
    background: var(--paper-sunk);
  }

  .place-main {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 10rem;
  }

  .place-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.02rem;
    color: var(--indigo);
  }

  .place-area {
    font-size: 0.85rem;
    color: var(--ink);
    opacity: 0.65;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: var(--paper-sunk);
    color: var(--indigo);
    border: 1px solid var(--rule);
    white-space: nowrap;
  }

  /* Subtle per-category tint — falls back to the default indigo tag above
     if a type doesn't match one of these keys. */
  .tag[data-tag='vegetarian'] {
    color: #3f7d4a;
    border-color: #bfe0c4;
    background: #eef8ef;
  }

  .tag[data-tag='halal'] {
    color: #8a5a10;
    border-color: #ecd6ab;
    background: #fbf3e3;
  }

  .tag[data-tag='groceries'] {
    color: var(--indigo);
    border-color: var(--rule);
    background: var(--paper-sunk);
  }

  .ask {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  /* Below this width the side nav sits above the content as a horizontal
     scroller instead of squeezing a two-column layout onto a phone. */
  @media (max-width: 42rem) {
    /* .layout {
      grid-template-columns: 1fr;
    }

    .toc {
      position: static;
      overflow-x: auto;
      padding-bottom: 0.5rem;
    }

    .toc ul {
      display: flex;
      gap: 0.5rem;
      border-left: none;
      white-space: nowrap;
    }

    .toc a {
      border: 1px solid var(--rule);
      border-radius: 999px;
      padding: 0.35rem 0.9rem;
      margin-left: 0;
    }

    .toc a:hover {
      border-color: var(--indigo-soft);
    } */
     
    .toc ul {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 0.4rem;
      scrollbar-width: none;
    }

    .toc ul::-webkit-scrollbar {
      display: none;
    }

    .place {
      flex-direction: column;
      align-items: flex-start;
    }

    /* Table rows stack on phones: term on top, description underneath. */
    .quick thead {
      display: none;
    }

    .quick,
    .quick tbody,
    .quick tr,
    .quick th,
    .quick td {
      display: block;
      width: 100%;
    }

    .quick tbody tr:not(.group-row) {
      padding: 0.75rem 1rem;
      border-bottom: 1px solid var(--rule);
    }

    .quick tbody tr:last-child {
      border-bottom: none;
    }

    .quick tbody tr:not(.group-row) th,
    .quick tbody tr:not(.group-row) td {
      padding: 0;
      border: none;
      width: auto;
    }

    .quick tbody tr:not(.group-row) td {
      margin-top: 0.2rem;
    }
  }
</style>