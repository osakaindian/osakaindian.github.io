---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';

// Edit this list to change the guide. Each section renders as a block, and
// the side navigation is generated from the same titles — add a section here
// and a link appears automatically, nothing else to update.
const sections = [
  {
    title: 'Your first two weeks',
    items: [
      ['Residence card and ward office', 'Register your address at the ward office within 14 days of arriving. Bring your residence card and passport. Enrolment in National Health Insurance usually happens at the same counter on the same visit.'],
      ['My Number', 'The card arrives by post a few weeks after you register. You will need it for a bank account and for most part-time work.'],
      ['Bank account', 'Japan Post Bank accepts new arrivals with the fewest questions. Most other banks want six months of residence first.'],
      ['SIM Card', 'Cheap SIM providers like IIJmio or Rakuten cost far less than the big three carriers and only need your residence card.'],
    ],
  },
  {
    title: 'Groceries',
    items: [
      ['Spices and Lentils', 'Several Indian and halal shops around Nipponbashi and Namba carry atta, dals and fresh coriander. Ask in the group chat for the current favourite — they open and close often.'],
      ['Vegetarian and Halal', 'Read labels for dashi and pork gelatine, which appear in unexpected places. Gyomu Supa stocks large frozen vegetable bags cheaply.'],
    ],
  },
  {
    title: 'Getting Around',
    items: [
      ['ICOCA card', 'One card for trains, subways, buses and convenience stores. Buy it at any station machine.'],
      ['Bicycle registration', 'Register your bike at the shop where you buy it. Unregistered bikes get stopped, and abandoned bikes get impounded quickly.'],
    ],
  },
  {
    title: 'When something goes wrong',
    items: [
      ['Medical Care', 'Your insurance card covers 70% at any clinic. Large hospitals prefer a referral letter from a small clinic first.'],
      ['Japanese-language help', 'Osaka Prefecture runs a free multilingual consultation service for foreign residents covering visas, housing and work trouble.'],
      ['Ask Us', 'Someone in the community has almost certainly dealt with your problem before.'],
    ],
  },
];

const slugify = (s: string) =>
  s.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---

<Base
  title="Living in Osaka"
  description="Practical notes for Indians arriving in Osaka: ward office, insurance, groceries, transport."
>
  <section class="band head">
    <div class="wrap wrap--narrow">
      <h1>Living in Osaka</h1>
      <p class="lede">
        The things we find ourselves explaining to every new arrival, written
        down once.
      </p>
    </div>
  </section>

  <section class="band top">
    <div class="wrap layout">
      <nav class="toc" aria-label="Sections on this page">
        <p class="toc-label">On this page</p>
        <ul>
          {
            sections.map((s) => (
              <li>
                <a href={`#${slugify(s.title)}`}>{s.title}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="content">
        <p class="caveat">
          Written by volunteers from experience, not by lawyers. Rules change —
          check with your ward office (which is city hall) or university
          international student office before acting on anything here.
        </p>

        {
          sections.map((s) => (
            <section class="sect" id={slugify(s.title)}>
              <h2>{s.title}</h2>
              <dl>
                {s.items.map(([term, body]) => (
                  <div>
                    <dt>{term}</dt>
                    <dd>{body}</dd>
                  </div>
                ))}
              </dl>
            </section>
          ))
        }

        <p class="ask">
          Something missing? <a href={`mailto:${site.email}`}>Tell us</a> and we
          will add it.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .head {
    padding-block: clamp(2.5rem, 6vw, 4rem) 0;
  }

  .top {
    padding-top: 2.5rem;
  }

  /* wrap--narrow caps line length for reading; this page needs the wider
     wrap so the side nav has somewhere to sit. */
  .layout {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .content {
    max-width: 48rem;
  }

  .toc {
    position: sticky;
    top: 1.5rem;
  }

  .toc-label {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--indigo-soft);
    margin: 0 0 0.75rem;
  }

  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.1rem;
    border-left: 2px solid var(--rule);
  }

  .toc a {
    display: block;
    padding: 0.4rem 0 0.4rem 0.9rem;
    margin-left: -2px;
    border-left: 2px solid transparent;
    font-family: var(--font-display);
    font-size: 0.92rem;
    text-decoration: none;
    color: var(--indigo);
    line-height: 1.3;
  }

  .toc a:hover {
    color: var(--ink);
    border-left-color: var(--indigo-soft);
  }

  .caveat {
    background: var(--paper-sunk);
    border-left: 4px solid var(--indigo-soft);
    padding: 1rem 1.2rem;
    font-size: 0.95rem;
    color: var(--indigo);
    max-width: none;
  }

  .sect {
    margin-top: 3rem;
    scroll-margin-top: 1.5rem;
  }

  .sect:first-of-type {
    margin-top: 2.5rem;
  }

  h2 {
    font-size: 1.6rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--rule);
  }

  dl {
    margin: 1.5rem 0 0;
    display: grid;
    gap: 1.5rem;
  }

  dt {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    margin-bottom: 0.25rem;
  }

  dd {
    margin: 0;
    max-width: var(--measure);
  }

  .ask {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  /* Below this width the side nav sits above the content as a horizontal
     scroller instead of squeezing a two-column layout onto a phone. */
  @media (max-width: 42rem) {
    .layout {
      grid-template-columns: 1fr;
    }

    .toc {
      position: static;
      overflow-x: auto;
      padding-bottom: 0.5rem;
    }

    .toc ul {
      display: flex;
      gap: 0.5rem;
      border-left: none;
      white-space: nowrap;
    }

    .toc a {
      border: 1px solid var(--rule);
      border-radius: 999px;
      padding: 0.35rem 0.9rem;
      margin-left: 0;
    }

    .toc a:hover {
      border-color: var(--indigo-soft);
    }
  }
</style>
