---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Base title="Posts" description="Announcements, job postings, scholarships and community notices from the Osaka Indian Association.">
  <section class="band head">
    <div class="wrap wrap--narrow">
      <h1>Posts</h1>
      <p class="lede">Announcements, opportunities and anything worth sharing with the community.</p>
    </div>
  </section>

  <section class="band top">
    <div class="wrap wrap--narrow">
      <PostList posts={posts} />
    </div>
  </section>
</Base>

<style>
  .head {
    padding-block: clamp(2.5rem, 6vw, 4rem) 0;
  }

  .top {
    padding-top: 2.5rem;
  }
</style>
