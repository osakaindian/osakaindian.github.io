            {rest.length > listed.length && (
              <p class="more"><a href="/events/">All upcoming events</a></p>
            )}
          </>
        ) : (
          <p class="empty">
            {heroEvent ? 'Nothing else on the calendar yet.' : 'Nothing on the calendar yet.'}
            Events usually go up two to three weeks ahead —
            <a href="/contact/">tell us what you’d like to see</a>.
          </p>
        )
      }
    </div>
  </section> -->

