---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import EventRow from '../components/EventRow.astro';
import { site, whoWeAre } from '../site.config';
import { isUpcoming } from '../lib/date';
import StatLine from '../components/StatLine.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
import MemberVoice from '../components/MemberVoice.astro';

const all = (await getCollection('events', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.date.getTime() - b.data.date.getTime()
);

const upcoming = all.filter((e) => isUpcoming(e.data.date, e.data.endDate));

const recent = all
  .filter((e) => !isUpcoming(e.data.date, e.data.endDate))
  .reverse()
  .slice(0, 3);

// Hero shows only our own events
const heroEvent = upcoming[0];
const rest = upcoming.slice(1);
const listed = rest.slice(0, 3);

const next = heroEvent
  ? {
      slug: heroEvent.id,
      title: heroEvent.data.title,
      date: heroEvent.data.date,
      venue: heroEvent.data.venue,
    }
  : undefined;
---

<Base>
  <Hero next={next} />
  <!-- <StatLine /> -->

  <section class="band">
    <div class="wrap">
      <h2>What’s coming up</h2>
      {
        listed.length > 0 ? (
          <>
            <div class="list">
              {listed.map((e) => (
                <EventRow
                  slug={e.id}
                  title={e.data.title}
                  date={e.data.date}
                  endTime={e.data.endTime}
                  venue={e.data.venue}
                  summary={e.data.summary}
                  organizer={e.data.organizer}
                />
              ))}
            </div>
            {rest.length > listed.length && (
              <p class="more"><a href="/events/">All upcoming events</a></p>
            )}
          </>
        ) : (
          <p class="empty">
            {heroEvent ? 'Nothing else on the calendar yet.' : 'Nothing on the calendar yet.'}
            Events usually go up two to three weeks ahead —
            <a href="/contact/">tell us what you’d like to see</a>.
          </p>
        )
      }
    </div>
  </section>

  <!-- <PhotoStrip /> -->

  {
    recent.length > 0 && (
      <section class="band">
        <div class="wrap">
          <h2>Recently</h2>
          <div class="list">
            {recent.map((e) => (
              <EventRow
                slug={e.id}
                title={e.data.title}
                date={e.data.date}
                endTime={e.data.endTime}
                venue={e.data.venue}
                summary={e.data.summary}
                organizer={e.data.organizer}
                past
              />
            ))}
          </div>
          <p class="more"><a href="/events/">All past events</a></p>
        </div>
      </section>
    )
  }

  <!-- <MemberVoice quotes={
    [
    {
      text: 'REPLACE WITH A REAL QUOTE',
      name: 'First name',
      detail: 'Where they study or work, and when they arrived'
    },
    {
      text: 'REPLACE WITH A REAL QUOTE',
      name: 'First name',
      detail: 'Where they study or work, and when they arrived'
    },
    {
      text: 'REPLACE WITH A REAL QUOTE',
      name: 'First name',
      detail: 'Where they study or work, and when they arrived'
    },
    {
      text: 'REPLACE WITH A REAL QUOTE',
      name: 'First name',
      detail: 'Where they study or work, and when they arrived'
    },
    ]
    }/> -->

  <section class="band band--sunk">
    <div class="wrap about">
      <h2>Who we are</h2>
      <p>
        A community of Indian students, researchers, professionals,
        families, and alumni in and around Osaka. New here or here for years, you're welcome.
      </p>
      <ul class="groups">
        {whoWeAre.map((g) => <li>{g.group}</li>)}
      </ul>
      <p><a href="/about/">Learn more about the association →</a></p>
    </div>
  </section>

  <section class="band band--ink">
    <div class="wrap join">
      <h2>New to Osaka?</h2>
      <p>
        Come to one thing. You don’t need to know anyone, and nobody will ask
        you to volunteer for anything on your first visit.
      </p>
      <div class="acts">
        <a class="btn" href={site.joinFormUrl || '/contact/'}>Join the community</a>
        <a class="btn btn--quiet quiet-on-ink" href="/resources/">Settling-in guide</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .list {
    border-bottom: 1px solid var(--rule);
  }

  .empty {
    color: var(--indigo);
    border-top: 1px solid var(--rule);
    padding-top: 1.5rem;
  }

  .about p {
    max-width: 60ch;
  }

  .groups {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .groups li {
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--rule);
    border-left: 3px solid var(--marigold);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .more {
    margin-top: 1.5rem;
  }

  .join p {
    max-width: 46ch;
    color: var(--paper);
  }

  .acts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .quiet-on-ink {
    color: var(--paper);
    border-color: var(--paper);
  }

  .quiet-on-ink:hover {
    background: var(--paper);
    color: var(--ink);
  }
</style>
