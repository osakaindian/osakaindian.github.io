  <section class="band band--sunk">
    <div class="wrap about">
      <h2>Who we are</h2>
      <p>
        A community of Indian students, researchers, professionals,
        families, and alumni in and around Osaka. New here or here for years, you're welcome.
      </p>
      <ul class="groups">
        {whoWeAre.map((g) => <li>{g.group}</li>)}
      </ul>
      <p><a href="/about/">Learn more about the association →</a></p>
    </div>
  </section>

  <section class="band band--ink">
    <div class="wrap join">
      <h2>New to Osaka?</h2>
      <p>
        Come to one thing. You don’t need to know anyone, and nobody will ask
        you to volunteer for anything on your first visit.
      </p>
      <div class="acts">
        <a class="btn" href={site.joinFormUrl || '/contact/'}>Join the community</a>
        <a class="btn btn--quiet quiet-on-ink" href="/resources/">Settling-in guide</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .list {
    border-bottom: 1px solid var(--rule);
  }

  .empty {
    color: var(--indigo);
    border-top: 1px solid var(--rule);
    padding-top: 1.5rem;
  }

  .about p {
    max-width: 60ch;
  }

  .groups {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .groups li {
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--rule);
    border-left: 3px solid var(--marigold);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .more {
    margin-top: 1.5rem;
  }

  .join p {
    max-width: 46ch;
    color: var(--paper);
  }

  .acts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .quiet-on-ink {
    color: var(--paper);
    border-color: var(--paper);
  }

  .quiet-on-ink:hover {
    background: var(--paper);
    color: var(--ink);
  }

  .posts {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .posts li + li {
    border-top: 1px solid var(--rule);
  }

  .posts a {
    display: grid;
    gap: 1.5rem;
    padding: 1.1rem 0;
    text-decoration: none;
    color: inherit;
  }

  .posts a.post--img {
    grid-template-columns: 240px 1fr;
    align-items: center;
  }

  .post-text {
    display: grid;
    gap: 0.25rem;
  }

  .post-media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--rule);
    border-radius: 10px;
    border: 1px solid var(--rule);
  }

  .post-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .posts a:hover .post-media img {
    transform: scale(1.04);
  }

  @media (max-width: 640px) {
    .posts a.post--img {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-media img {
      transition: none;
    }
    .posts a:hover .post-media img {
      transform: none;
    }
  }

  .posts time {
    font-size: 0.85rem;
    color: var(--indigo);
  }

  .post-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
  }

  .post-summary {
    max-width: 60ch;
    color: var(--indigo);
  }

  .posts a:hover .post-title {
    text-decoration: underline;
    text-decoration-color: var(--marigold);
    text-underline-offset: 0.2em;
  }

  .band--posts {
    padding-top: calc(var(--step) * 0.5);
  }
</style>
