---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import EventRow from '../components/EventRow.astro';
import { site, whoWeAre } from '../site.config';
import { isUpcoming } from '../lib/date';
import StatLine from '../components/StatLine.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
import MemberVoice from '../components/MemberVoice.astro';

const all = (await getCollection('events', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.date.getTime() - b.data.date.getTime()
);

const upcoming = all.filter((e) => isUpcoming(e.data.date, e.data.endDate));

const recent = all
  .filter((e) => !isUpcoming(e.data.date, e.data.endDate))
  .reverse()
  .slice(0, 3);

// Hero shows only our own events
const heroEvent = upcoming[0];
const rest = upcoming.slice(1);
const listed = rest.slice(0, 3);

const next = heroEvent
  ? {
      slug: heroEvent.id,
      title: heroEvent.data.title,
      date: heroEvent.data.date,
      venue: heroEvent.data.venue,
    }
  : undefined;

const latestPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const shownPosts = latestPosts.slice(0, 3);
---

<Base>
  <Hero
    next={next}
    latest={shownPosts[0] && {
      slug: shownPosts[0].id,
      title: shownPosts[0].data.title,
    }}
  />
  <!-- <StatLine /> -->

  {
    shownPosts.length > 0 && (
      <section class="band band--posts">
        <div class="wrap">
          <h2>Latest posts</h2>
          <ul class="posts">
            {shownPosts.map((p) => (
              <li>
                <a href={`/posts/${p.id}/`} class:list={['post', { 'post--img': p.data.cover }]}>
                  {p.data.cover && (
                    <div class="post-media">
                      <img src={p.data.cover} alt="" loading="lazy" decoding="async" />
                    </div>
                  )}
                  <div class="post-text">
                    <time datetime={p.data.date.toISOString()}>
                      {p.data.date.toLocaleDateString('en-GB', {
                        day: 'numeric',
                        month: 'short',
                        year: 'numeric',
                      })}
                    </time>
                    <span class="post-title">{p.data.title}</span>
                    {p.data.summary && <span class="post-summary">{p.data.summary}</span>}
                  </div>
                </a>
              </li>
            ))}
          </ul>
          {latestPosts.length > shownPosts.length && (
            <p class="more"><a href="/posts/">See more posts →</a></p>
          )}
        </div>
      </section>
    )
  }

