---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EventRow from '../../components/EventRow.astro';
import { isUpcoming, year } from '../../lib/date';

const all = (await getCollection('events', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.date.getTime() - b.data.date.getTime()
);

const upcoming = all.filter((e) => isUpcoming(e.data.date));
const past = all.filter((e) => !isUpcoming(e.data.date)).reverse();

// Group past events by year so the archive stays readable as it grows.
const byYear = new Map<string, typeof past>();
for (const e of past) {
  const y = year(e.data.date);
  byYear.set(y, [...(byYear.get(y) ?? []), e]);
}
---

<Base
  title="Events"
  description="Cultural celebrations, community gatherings and activities organised by the Osaka Indian Association."
>
  <section class="band head">
    <div class="wrap wrap--narrow">
      <h1>Events</h1>
      <p class="lede">
        Bringing the Indian community in Osaka together through cultural
        celebrations, social gatherings, and activities throughout the year.
      </p>
    </div>
  </section>

  <section class="band">
    <div class="wrap wrap--narrow">
      <h2>Upcoming Events</h2>

      {
        upcoming.length ? (
          <div class="list">
            {upcoming.map((e) => (
              <EventRow
                slug={e.id}
                title={e.data.title}
                date={e.data.date}
                endTime={e.data.endTime}
                venue={e.data.venue}
                summary={e.data.summary}
              />
            ))}
          </div>
        ) : (
          <p class="empty">
            There are no upcoming events at the moment. Please check back soon for new announcements.
          </p>
        )
      }
    </div>
  </section>

  {
    past.length > 0 && (
      <section class="band band--sunk">
        <div class="wrap wrap--narrow">
          <h2>Past Events</h2>

          {
            past.length ? (
              <div class="list">
                {past.map((e) => (
                  <EventRow
                    slug={e.id}
                    title={e.data.title}
                    date={e.data.date}
                    endTime={e.data.endTime}
                    venue={e.data.venue}
                    summary={e.data.summary}
                  />
                ))}
              </div>
            ) : (
              <p class="empty">Our event archive will appear here.</p>
            )
          }
        </div>
      </section>
    )
  }
</Base>

<style>
  .head {
    padding-block: clamp(2.5rem, 6vw, 4rem) 0;
  }

  .head h1 {
    font-size: clamp(2.6rem, 6vw, 4rem);
  }

  .list {
    border-bottom: 1px solid var(--rule);
  }

  .empty {
    border-top: 1px solid var(--rule);
    padding-top: 1.5rem;
    color: var(--indigo);
  }

  .yeargroup + .yeargroup {
    margin-top: 3rem;
  }

  .y {
    font-size: 1rem;
    color: var(--indigo-soft);
    margin-bottom: 0.4rem;
  }
</style>
