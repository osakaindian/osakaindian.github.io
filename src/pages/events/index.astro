---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EventCard from '../../components/EventCard.astro';
import { isUpcoming, year } from '../../lib/date';

const all = (await getCollection('events', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.date.getTime() - b.data.date.getTime()
);

const upcoming = all.filter((e) => isUpcoming(e.data.date));
const past = all.filter((e) => !isUpcoming(e.data.date)).reverse();

// Group past events by year so the archive stays readable as it grows.
const byYear = new Map<string, typeof past>();
for (const e of past) {
  const y = year(e.data.date);
  byYear.set(y, [...(byYear.get(y) ?? []), e]);
}
---

<Base title="Events" description="Gatherings, festivals and meetups run by the Osaka Indian Association.">
  <section class="band head">
    <div class="wrap">
      <h1>Events</h1>
      <p class="lede">
        Festivals, welcome dinners and casual meetups. Most are free; a few ask
        for a small contribution towards food.
      </p>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>Upcoming</h2>
      {
        upcoming.length ? (
          <div class="grid">
            {upcoming.map((e) => (
              <EventCard
                slug={e.id}
                title={e.data.title}
                date={e.data.date}
                endTime={e.data.endTime}
                venue={e.data.venue}
                summary={e.data.summary}
                cover={e.data.cover}
              />
            ))}
          </div>
        ) : (
          <p class="empty">Nothing scheduled right now. Check back soon.</p>
        )
      }
    </div>
  </section>

  {
    past.length > 0 && (
      <section class="band band--sunk">
        <div class="wrap">
          <h2>Past events</h2>
          {[...byYear.entries()].map(([y, items]) => (
            <div class="yeargroup">
              <h3 class="y">{y}</h3>
              <div class="grid">
                {items.map((e) => (
                  <EventCard
                    slug={e.id}
                    title={e.data.title}
                    date={e.data.date}
                    endTime={e.data.endTime}
                    venue={e.data.venue}
                    summary={e.data.summary}
                    cover={e.data.cover}
                    past
                  />
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }
</Base>

<style>
  .head {
    padding-block: clamp(2.5rem, 6vw, 4rem) 0;
  }

  .head h1 {
    font-size: clamp(2.6rem, 6vw, 4rem);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1.75rem;
  }

  .empty {
    border-top: 1px solid var(--rule);
    padding-top: 1.5rem;
    color: var(--indigo);
  }

  .yeargroup + .yeargroup {
    margin-top: 3rem;
  }

  .y {
    font-size: 1rem;
    color: var(--indigo-soft);
    margin-bottom: 1rem;
  }
</style>
