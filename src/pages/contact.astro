---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';

const socials = Object.entries(site.social).filter(([, url]) => url);
const labels: Record<string, string> = {
  instagram: 'Instagram',
  facebook: 'Facebook',
  whatsapp: 'WhatsApp group',
  line: 'LINE',
};
---

<Base title="Contact" description="How to reach the Osaka Indian Association and join the community.">
  <section class="band head">
    <div class="wrap wrap--narrow">
      <h1>Contact</h1>
      <p class="lede">
        Email us with any questions, or join our community groups for event updates and announcements.
      </p>
    </div>
  </section>

  <section class="band top">
    <div class="wrap wrap--narrow">
      {
        site.joinFormUrl && (
          <div class="joinbox">
            <h2>Join the community</h2>
            <p>
              Fill in the short registration form to get announcements and join our group channels.
            </p>
            <p>
              <a class="btn" href={site.joinFormUrl}>Join the Community</a>
            </p>
          </div>
        )
      }

      <h2>Send us a message</h2>

      <form class="form" id="contact-form">
        <input type="hidden" name="access_key" value={site.contactFormKey} />
        <input type="hidden" name="from_name" value="OIA website contact form" />
        <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" />

        <label>
          <span>Your name</span>
          <input type="text" name="name" required autocomplete="name" />
        </label>

        <label>
          <span>Your email</span>
          <input type="email" name="email" required autocomplete="email" />
        </label>

        <label>
          <span>Subject</span>
          <input type="text" name="subject" required />
        </label>

        <label>
          <span>Message</span>
          <textarea name="message" rows="6" required></textarea>
        </label>

        <button class="btn" type="submit">Send message</button>
        <p class="status" id="form-status" role="status" aria-live="polite"></p>
      </form>

      <p class="fallback">
        Prefer email? Write to <a href={`mailto:${site.email}`}>{site.email}</a>. We are a small
        team, so replies may take a little time. For urgent questions about an upcoming event,
        our group channels are usually faster.
      </p>

      {
        socials.length > 0 && (
          <>
            <h2>Community channels</h2>
            <ul class="socials">
              {socials.map(([key, url]) => (
                <li>
                  <a href={url} rel="noopener">{labels[key] ?? key}</a>
                </li>
              ))}
            </ul>
          </>
        )
      }

      <h2>Collaborations and event listings</h2>
      <p>
        Universities, companies, student groups, and community organisations are welcome to
        email us about collaborations. If you know of an event across Kansai that the
        community might enjoy, tell us and we may share it.
      </p>
    </div>
  </section>
</Base>

<style>
  .head {
    padding-block: clamp(2.5rem, 6vw, 4rem) 0;
  }

  .top {
    padding-top: 2.5rem;
  }

  .joinbox {
    background: var(--paper-sunk);
    border-left: 5px solid var(--marigold);
    padding: 1.5rem 1.6rem;
    margin-bottom: 3rem;
  }

  .joinbox h2 {
    margin-top: 0;
  }

  h2 {
    font-size: 1.5rem;
    margin-top: 2.4rem;
  }

  .big {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 3vw, 1.9rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere; /* stops a long email address overflowing on phones */
  }

  .socials {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    if (status) status.textContent = 'Sending…';

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form),
      });
      const data = await res.json();

      if (data.success) {
        form.reset();
        if (status) status.textContent = 'Thank you! Your message has been sent.';
      } else {
        throw new Error(data.message);
      }
    } catch {
      if (status)
        status.textContent = 'Sorry, something went wrong. Please email us directly instead.';
    } finally {
      btn.disabled = false;
    }
  });
</script>