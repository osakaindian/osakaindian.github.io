---
import Base from '../layouts/Base.astro';
import MemberCard from '../components/MemberCard.astro';
import { team, site } from '../site.config';
---

<Base title="Team" description="The volunteers currently running the Osaka Indian Association.">
  <section class="band head">
    <div class="wrap">
      <h1>Team</h1>
      <p class="lede">
        The committee changes every year. These are the people to write to right
        now.
      </p>
    </div>
  </section>

  <section class="band top">
    <div class="wrap">
      <div class="grid">
        {team.map((m) => <MemberCard {...m} />)}
      </div>

      <p class="note">
        Committee positions open up each spring. If you want to stand for one,
        write to <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .head {
    padding-block: clamp(2.5rem, 6vw, 4rem) 0;
  }

  .top {
    padding-top: 2.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12.5rem, 1fr));
    gap: 2rem 1.75rem;
  }

  .note {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    color: var(--indigo);
  }
</style>
