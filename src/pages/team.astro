---
import Base from '../layouts/Base.astro';
import MemberCard from '../components/MemberCard.astro';
import { team, site } from '../site.config';
---

<Base title="Team" description="Meet the team supporting the Osaka Indian Association and its activities across the community.">
  <section class="band head">
    <div class="wrap wrap--narrow">
      <h1>Our Team</h1>
      <p class="lede">
        Osaka Indian Association brings together members of the Indian community from a range of backgrounds who contribute their experience, ideas, and time to support the 
        association's activities.  
      </p>
    </div>
  </section>

  <section class="band top">
    <div class="wrap wrap--narrow">
      <div class="grid">
        {team.map((m) => <MemberCard {...m} />)}
      </div>

      <h2>Get Involved</h2>
      <p class="note">
        OIA welcomes members of the community who would like to contribute. Whether you have an idea for an event, a particular skill to share, or simply an interest in 
        supporting the community, we would be pleased to hear from you.
        <a href={`mailto:${site.email}`}>Contact us</a> to learn more about getting involved.
      </p>
    </div>
  </section>
</Base>

<style>
  .head {
    padding-block: clamp(2.5rem, 6vw, 4rem) 0;
  }

  .top {
    padding-top: 2.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12.5rem, 1fr));
    gap: 2rem 1.75rem;
  }

  .note {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    color: var(--indigo);
  }
</style>
